{
  "name": "@vsreact/posthog",
  "version": "0.0.2",
  "description": "PostHog analytics for VSReacT plugins — capture from your React UI, delivered over HTTPS by the native PostHogBridge.",
  "keywords": [
    "posthog",
    "analytics",
    "vsreact",
    "juce",
    "vst",
    "audio-plugin",
    "telemetry"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://vsreact.n9records.com/docs/posthog",
  "bugs": "https://github.com/N9RecordsTechnologiesIL/VSReacT/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N9RecordsTechnologiesIL/VSReacT.git",
    "directory": "vsreact/js-posthog"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
